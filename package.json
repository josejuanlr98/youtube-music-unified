{
  "name": "decky-youtube-music-cast",
  "version": "0.6.4",
  "description": "YouTube Music player and YouTube Cast receiver for Steam Deck.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "node tests/test_cast_lifecycle.cjs && node tests/test_054.cjs && node tests/test_notifications.cjs && node tests/test_cast_only.cjs && node tests/test_cast_transport.cjs && node tests/test_fullscreen.cjs",
    "test:python": "python -m unittest discover -s tests -v",
    "build:backend": "esbuild backend/src/server.ts --bundle --platform=node --format=cjs --outfile=backend/out/server.cjs --external:bufferutil --external:utf-8-validate",
    "package": "powershell -ExecutionPolicy Bypass -File build.ps1"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "deck"
  ],
  "author": "josejuanlr98",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.20.0",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0",
    "ws": "^8.16.0",
    "yt-cast-receiver": "^2.1.0"
  }
}
